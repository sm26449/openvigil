# OpenVigil — configurarea instalarii. Copiaza in `.env` si completeaza.
# Tot ce nu e aici se seteaza din interfata (Setari) si ajunge in data/settings.json.

# Numele sistemului (titlu, 2FA, notificari)
NVR_NAME=OpenVigil

# Fusul orar al gazdei (numele segmentelor e in UTC, afisarea e locala)
TZ=Europe/Bucharest

# Utilizatorul din containere = proprietarul fisierelor din data/ (id -u / id -g)
PUID=1000
PGID=1000

# Unde stau inregistrarile, bazele de date, modelele descarcate (cai pe gazda)
DATA_DIR=./data
MODELS_DIR=./models

# Porturi (retea de gazda: schimba daca sunt ocupate)
WEB_PORT=8079
STREAM_PORT=8076
AI_PORT=8077

# In spatele unui reverse proxy cu TLS: HTTPS=true pune cookie-ul Secure si cere
# ca push-ul web sa mearga. COOKIE_DOMAIN e optional (ex. .exemplu.ro).
HTTPS=false
COOKIE_DOMAIN=
TRUSTED_PROXIES=127.0.0.0/8,::1/128,172.16.0.0/12

# 0 = rezolutie nativa la HD/playback (recomandat cu GPU); ex. 1440 pe legaturi lente
PLAYBACK_HEIGHT=0

# Optional: un NVR Hikvision existent (sursa de rezerva + istoric vechi). Gol = fara.
NVR_IP=
NVR_PORT=554
NVR_USER=admin
NVR_PASS=

# Optional, doar ca valori de pornire (se seteaza din Setari -> Notificari)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_LABELS=person,dog,cat,bear
NOTIFY_COOLDOWN=300

# Inregistrare: retentie (zile) si spatiu liber minim (GB) sub care se sterg cele mai vechi
RECORD_KEEP_DAYS=14
RECORD_MIN_FREE_GB=50
