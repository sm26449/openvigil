  {
    "id": "sw1",
    "type": "switch",
    "z": "tab1",
    "name": "ce fel de eveniment",
    "property": "payload.eveniment",
    "propertyType": "msg",
    "rules": [
      {
        "t": "eq",
        "v": "detectie",
        "vt": "str"
      },
      {
        "t": "eq",
        "v": "alarma_camera",
