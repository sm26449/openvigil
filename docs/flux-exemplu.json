    "wires": [
      [
        "f_om",
        "f_animal"
      ],
      [
        "f_spate"
      ]
    ]
  },
  {
    "id": "ok1",
    "type": "function",
    "z": "tab1",
    "name": "raspunde 200",
    "func": "msg.payload='';return msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 350,
    "y": 120,
    "wires": [
      [
        "resp1"
      ]
    ]
  },
  {
    "id": "f_om",
    "type": "function",
    "z": "tab1",
    "name": "om la intrare? (pauza 60s)",
    "func": "const p = msg.payload;\nif (p.eticheta !== 'person') return null;\nif (p.camera.grup !== 'Intrari') return null;\n// fara pauza, cine sta la poarta e salutat la fiecare cadru\nconst k = 'salut' + p.camera.id;\nconst acum = Date.now();\nif (acum - (flow.get(k) || 0) < 60000) return null;\nflow.set(k, acum);\nmsg.url = 'http://192.168.1.50:8079/api/v1/camera/' + p.camera.id + '/anunt';\nmsg.payload = { text: 'Buna ziua. Va rugam asteptati, venim imediat.' };\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 590,
    "y": 180,
    "wires": [
      [
        "req"
      ]
    ]
  },
  {
    "id": "f_spate",
    "type": "function",
    "z": "tab1",
    "name": "miscare in grupul Spate",
    "func": "const p = msg.payload;\nif (p.camera.grup !== 'Spate') return null;\n// filtram pe grup, nu pe id-uri: o camera noua in grup intra singura in flux\nmsg.url = 'http://192.168.1.50:8079/api/v1/camera/' + p.camera.id + '/releu';\nmsg.payload = { pornit: true, port: 1 };\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 590,
    "y": 260,
    "wires": [
      [
        "req"
      ]
    ]
  },
  {
    "id": "f_animal",
    "type": "function",
    "z": "tab1",
    "name": "animal detectat -> ia poza",
    "func": "const p = msg.payload;\nif (!['dog','cat','bird','horse','sheep','cow','bear'].includes(p.eticheta)) return null;\nmsg.method = 'GET';\nmsg.url = 'http://192.168.1.50:8079/api/v1/camera/' + p.camera.id + '/poza';\nmsg.titlu = p.eticheta_ro + ' la ' + p.camera.nume;\nmsg.payload = null;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 590,
    "y": 340,
    "wires": [
      [
        "req_poza"
      ]
    ]
  },
