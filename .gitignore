# configurarea instalatiei si tot ce e generat la rulare — NU intra in git
.env
# copiile de siguranta ale .env (.env.pre-*, .env.bak*) contin secrete — nu scapa in git (PUB-01).
# .env.example ramane urmarit (sablonul public, folosit si de CI).
.env.*
!.env.example
.compose-files
data/
models/
venv/
__pycache__/
*.pyc
*.log
nohup.out

# teste in browser
tests/node_modules/
tests/*.png
tests/_audit/

# instalare clasica (fara Docker)
go2rtc/

# Cheia serviciului de alerte (alertd) — secret, nu se comite
alertd.env
alertd*.env
